PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ESP32_SHARED_SECRET=change-me
DEFAULT_TARIFF=0.02
DEFAULT_LPCD_LIMIT=135
APP_TIMEZONE=Asia/Kolkata

# Email. The address every message is sent from:
MAIL_FROM=Water Distribution <you@example.com>

# Option 1 - SMTP (for Gmail: host smtp.gmail.com, port 587, your address, and an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option 2 - Brevo's HTTP API. Use this where outbound SMTP is blocked by the host.
BREVO_API_KEY=

# Online bill payment. From the Razorpay dashboard: Account & Settings > API Keys.
# Keys that start with rzp_test_ take test payments only; no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
